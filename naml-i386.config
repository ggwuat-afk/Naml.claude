# ============================================================================
# naml-i386.config — يُدمج فوق allnoconfig ثم olddefconfig
# i386 · 256MB RAM · initramfs · /dev/fb0 @800x600 · أقل استهلاك ذاكرة
# ============================================================================

# ==== 1) المعمارية / المعالج / الذاكرة ====
CONFIG_X86_32=y
# CONFIG_64BIT is not set
CONFIG_M686=y
# CONFIG_MPENTIUM4=y
# CONFIG_MK7=y
# CONFIG_M486 is not set
# CONFIG_M586 is not set
# CONFIG_SMP is not set
# CONFIG_X86_PAE is not set
CONFIG_NOHIGHMEM=y
# CONFIG_HIGHMEM4G is not set
CONFIG_VMSPLIT_3G=y
CONFIG_EXPERT=y
CONFIG_MULTIUSER=y
CONFIG_BASE_FULL=y
CONFIG_BUG=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_KERNEL_GZIP=y
# CONFIG_KERNEL_XZ is not set
# CONFIG_KERNEL_ZSTD is not set
CONFIG_UNWINDER_GUESS=y
# CONFIG_UNWINDER_FRAME_POINTER is not set
# CONFIG_RELOCATABLE is not set
# CONFIG_RANDOMIZE_BASE is not set
CONFIG_LOG_BUF_SHIFT=16
CONFIG_PRINTK_SAFE_LOG_BUF_SHIFT=12
CONFIG_HZ_100=y
CONFIG_HZ=100
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_SWAP=y
# CONFIG_MEMCG is not set
# CONFIG_CGROUPS is not set
# CONFIG_NAMESPACES is not set
# CONFIG_KSM is not set
# CONFIG_TRANSPARENT_HUGEPAGE is not set
# CONFIG_INIT_ON_ALLOC_DEFAULT_ON is not set
# CONFIG_INIT_ON_FREE_DEFAULT_ON is not set
# CONFIG_SLUB_DEBUG is not set
# CONFIG_PAGE_POISONING is not set
# CONFIG_DEBUG_PAGEALLOC is not set
# CONFIG_VM_EVENT_COUNTERS is not set

# ==== 2) تنفيذ المستخدمين + initramfs ====
CONFIG_BLOCK=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
CONFIG_INITRAMFS_SOURCE=""
# CONFIG_BLK_DEV_RAM is not set
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
# CONFIG_BINFMT_MISC is not set
# CONFIG_COREDUMP is not set
# CONFIG_MODULES is not set

# ==== 3) syscalls لازمة لأي userland ====
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_POSIX_TIMERS=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_SYSVIPC=y
# CONFIG_AIO is not set
# CONFIG_IO_URING is not set
# CONFIG_BPF_SYSCALL is not set
# CONFIG_SECCOMP is not set
# CONFIG_AUDIT is not set
# CONFIG_SECURITY is not set

# ==== 4) /proc /sys /dev /tmpfs ====
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_SHMEM=y
# CONFIG_TMPFS_POSIX_ACL is not set
CONFIG_UEVENT_HELPER=y
CONFIG_UEVENT_HELPER_PATH=""
# CONFIG_PROC_KCORE is not set
# CONFIG_SECURITYFS is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_CONFIGFS_FS is not set

# ==== 5) طرفية + لوحة مفاتيح PS/2 ====
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_VT_HW_CONSOLE_BINDING=y
CONFIG_UNIX98_PTYS=y
# CONFIG_LEGACY_PTYS is not set
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
# CONFIG_INPUT_MOUSE is not set
# CONFIG_INPUT_MOUSEDEV is not set
# CONFIG_INPUT_JOYSTICK is not set
# CONFIG_INPUT_TOUCHSCREEN is not set
# CONFIG_INPUT_MISC is not set
CONFIG_PRINTK=y
CONFIG_EARLY_PRINTK=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
# CONFIG_SERIAL_8250_MANY_PORTS is not set
# CONFIG_SERIAL_8250_PNP is not set

# ==== 6) FRAMEBUFFER — /dev/fb0 ====
# FB=y يختار FB_CORE=y قسراً (fbdev Kconfig) — لا حاجة لكتابتها.
CONFIG_FB=y
CONFIG_FB_DEVICE=y
CONFIG_FB_MODE_HELPERS=y
# CONFIG_FB_TILEBLITTING is not set
CONFIG_FB_VESA=y
# CONFIG_FB_EFI is not set
# CONFIG_FB_UVESA is not set
# CONFIG_FB_SIMPLE is not set
CONFIG_X86_SYSFB=y
CONFIG_SYSFB=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_FBDEV_OVERALLOC=100
# CONFIG_DRM_CLIENT_DEFAULT_LOGO is not set
# CONFIG_DRM_I915 is not set
# CONFIG_DRM_RADEON is not set
# CONFIG_DRM_NOUVEAU is not set
# CONFIG_DRM_BOCHS is not set
# CONFIG_DRM_CIRRUS_QEMU is not set
# CONFIG_DRM_VMWGFX is not set
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
# CONFIG_FRAMEBUFFER_CONSOLE_ROTATION is not set
CONFIG_FONT_8x16=y
# CONFIG_FONT_TER16x32 is not set
# CONFIG_LOGO is not set
CONFIG_VGA_CONSOLE=y

# ==== 7) عتاد أساسي + طاقة ====
CONFIG_PCI=y
# CONFIG_PCIEPORTBUS is not set
# CONFIG_PCI_MSI is not set
# CONFIG_HOTPLUG_PCI is not set
# CONFIG_EDD is not set
# CONFIG_ISA is not set
# PNP: ACPI يختارها قسراً (drivers/acpi/Kconfig) — لا تُطفأ
# MICROCODE: def_bool y مع CPU_SUP_INTEL (أي مع M686) — لا تُطفأ
# CONFIG_X86_PLATFORM_DEVICES is not set
# CONFIG_X86_MCE is not set
# CONFIG_CPU_FREQ is not set
CONFIG_ACPI=y
CONFIG_SUSPEND=y
# CONFIG_HIBERNATION is not set
# CONFIG_PM_DEBUG is not set
# CONFIG_ACPI_PROCESSOR is not set
# CONFIG_ACPI_THERMAL is not set
# CONFIG_ACPI_FAN is not set
# CONFIG_ACPI_VIDEO is not set
# CONFIG_ACPI_AC is not set
# CONFIG_ACPI_BATTERY is not set
# CONFIG_ACPI_DOCK is not set
CONFIG_APM=y
# CONFIG_APM_CPU_IDLE is not set
# CONFIG_APM_DISPLAY_BLANK is not set
CONFIG_MAGIC_SYSRQ=y
CONFIG_MAGIC_SYSRQ_DEFAULT_ENABLE=0x1
# CONFIG_MAGIC_SYSRQ_SERIAL is not set
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_CMOS=y

# ==== 8) شبكة دنيا (lo + AF_UNIX) ====
CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_UNIX=y
CONFIG_INET=y
# CONFIG_IPV6 is not set
# CONFIG_PACKET is not set
# CONFIG_NETFILTER is not set
# CONFIG_ETHERNET is not set
# CONFIG_WLAN is not set
# CONFIG_WIRELESS is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_SOUND is not set
# CONFIG_HID is not set

# ==== 9) إزالة كل ما يثقل النواة ====
# DEBUG_KERNEL: menuconfig EXPERT يختارها (init/Kconfig) — لا تُطفأ
# PERF_EVENTS: arch/x86 يختارها قسراً — لا تُطفأ
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_KALLSYMS is not set
# CONFIG_KALLSYMS_ALL is not set
# CONFIG_IKCONFIG is not set
# CONFIG_PROFILING is not set
# CONFIG_KPROBES is not set
# CONFIG_FTRACE is not set
# CONFIG_STACKTRACE is not set
# CONFIG_SCHEDSTATS is not set
# CONFIG_SCHED_DEBUG is not set
# CONFIG_DEBUG_BUGVERBOSE is not set
# CONFIG_SAMPLES is not set
# CONFIG_GCC_PLUGINS is not set

# ==== 10) سطر أوامر مدمج ====
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="console=tty1 quiet loglevel=3 edd=off panic=10"
# CONFIG_CMDLINE_OVERRIDE is not set

# ==== 11) اختياري: تسريع على معالج 2002 (جهاز غير متصل فقط) ====
# # CONFIG_RETPOLINE is not set
# # CONFIG_PAGE_TABLE_ISOLATION is not set
