# ============================================================================
# naml-desktop.config — شريحة إضافية فوق naml-i386.config + naml-disk.config
# i386 · سطح مكتب X11 على /dev/fb0 · لوحة PS/2 + USB
#   NAML_DESKTOP=1 BUILD → تُدمج تلقائياً في build-naml-kernel.sh
# ============================================================================

# ==== إدخال: ماوس PS/2 + evdev (Xorg يقرأ /dev/input/event*) ====
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y
CONFIG_MOUSE_PS2_ALPS=y
CONFIG_MOUSE_PS2_LOGIPS2PP=y
CONFIG_MOUSE_PS2_SYNAPTICS=y
CONFIG_MOUSE_PS2_TRACKPOINT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_EVBUG=n
CONFIG_INPUT_MOUSEDEV=n
CONFIG_INPUT_JOYSTICK=n
CONFIG_INPUT_TABLET=n
CONFIG_INPUT_TOUCHSCREEN=n
CONFIG_INPUT_MISC=n

# ==== USB: لوحة/ماوس USB على أجهزة 2002 (UHCI/OHCI) والحديثة (EHCI) ====
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
# HID_SUPPORT هو بوابة "HID bus support" في 6.6: بلاها تُهمَل HID/USB_HID كلياً
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_USB_HIDDEV=y
CONFIG_USB_STORAGE=y
CONFIG_USB_ANNOUNCE_NEW_DEVICES=n

# ==== Xorg: يحتاج هذه لتعمل ذاكرة مشتركة ونقاط طرفية ====
# CONFIG_SYSVIPC / CONFIG_SHMEM / CONFIG_TMPFS / CONFIG_UNIX98_PTYS تأتي من الشريحة الأساسية
CONFIG_UNIX98_PTYS=y

# ==== fb0 لـ X (fbdev + ShadowFB) ====
# ملاحظة: أي سطر يبدأ بـ "# CONFIG_" يعتبره merge_config قيمةً لا تعليقاً.
# FB و FB_DEVICE و FB_VESA تأتي من الشريحة الأساسية؛ نؤكد VESA هنا فقط.
CONFIG_FB_VESA=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y

# ==== قرص الجذر ext4 (من naml-disk.config، نؤكدها هنا للوضوح) ====
CONFIG_ATA=y
CONFIG_ATA_PIIX=y
CONFIG_BLK_DEV_SD=y
CONFIG_EXT4_FS=y
