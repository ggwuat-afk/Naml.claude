name: build-naml-kernel

on:
  workflow_dispatch:
    inputs:
      kernel_version:
        description: "Kernel version (check https://kernel.org for the current longterm release)"
        required: false
        default: "6.6.155"

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repo
        uses: actions/checkout@v4

      - name: Install build dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y \
            build-essential bc bison flex libssl-dev libelf-dev \
            gcc-multilib libc6-dev-i386 wget tar xz-utils patch

      - name: Download real kernel source from kernel.org
        run: |
          KVER="${{ github.event.inputs.kernel_version }}"
          if [ -z "$KVER" ]; then KVER="6.6.155"; fi
          KMAJOR="${KVER%%.*}"
          echo "KVER=$KVER" >> "$GITHUB_ENV"
          URL="https://cdn.kernel.org/pub/linux/kernel/v${KMAJOR}.x/linux-${KVER}.tar.xz"
          echo "Downloading $URL"
          wget -O linux-src.tar.xz "$URL"
          tar xf linux-src.tar.xz
          echo "SRC_DIR=$GITHUB_WORKSPACE/linux-$KVER" >> "$GITHUB_ENV"

      - name: Apply NAML patches (optional; skipped cleanly if not present)
        run: |
          cd "$SRC_DIR"
          PATCH_DIR="$GITHUB_WORKSPACE/kernel/patches"
          if [ ! -d "$PATCH_DIR" ]; then
            echo "No kernel/patches/ in this repo -- skipping. That's fine:"
            echo "they only add a cosmetic boot banner, nothing else depends on them."
            exit 0
          fi
          applied=0
          skipped=0
          for p in "$PATCH_DIR"/*.patch; do
            [ -e "$p" ] || continue
            name="$(basename "$p")"
            if patch -p1 --fuzz=3 --dry-run < "$p" >/tmp/dry.log 2>&1; then
              patch -p1 --fuzz=3 < "$p"
              echo "applied: $name"
              applied=$((applied + 1))
            else
              echo "SKIPPED: $name (does not apply cleanly against linux-$KVER -- expected, see README)"
              skipped=$((skipped + 1))
            fi
          done
          echo "Patches applied=$applied skipped=$skipped"

      - name: Configure (naml_defconfig -> olddefconfig)
        run: |
          cd "$SRC_DIR"
          cp "$GITHUB_WORKSPACE/kernel/naml_defconfig" .config
          make ARCH=i386 olddefconfig

      - name: Build the kernel
        run: |
          cd "$SRC_DIR"
          make ARCH=i386 -j"$(nproc)"

      - name: Collect output
        run: |
          mkdir -p "$GITHUB_WORKSPACE/out"
          cp "$SRC_DIR/arch/x86/boot/bzImage" "$GITHUB_WORKSPACE/out/vmlinuz-naml-$KVER"
          cp "$SRC_DIR/.config" "$GITHUB_WORKSPACE/out/config-naml-$KVER"

      - name: Upload kernel image as a downloadable artifact
        uses: actions/upload-artifact@v4
        with:
          name: naml-kernel-${{ env.KVER }}
          path: out/
          retention-days: 14
